# Copied to .env by `docker compose` users; values below are safe local defaults.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop?schema=public

# Operator key for /admin/* endpoints (non-model key -> lives in .env, never committed).
ADMIN_API_KEY=change-me-local-admin-key

# OpenAI-compatible model endpoint (OpenRouter). Leave the key empty and the app still boots;
# assistant endpoints then return 503. Export it in your shell rather than writing it here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
