generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Money is always stored as integer minor units (cents) to avoid float rounding.
model Product {
  id          String      @id @default(cuid())
  sku         String      @unique
  name        String
  description String      @default("")
  category    String
  brand       String?
  priceCents  Int
  currency    String      @default("USD") @db.Char(3)
  stock       Int         @default(0)
  attributes  Json        @default("{}")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([category])
  @@index([name])
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  /// SHA-256 of the customer's API token; the raw token is never stored.
  apiTokenHash  String         @unique
  createdAt     DateTime       @default(now())
  orders        Order[]
  conversations Conversation[]
  orderQuotes   OrderQuote[]
}

/// An assistant chat. `customerId` is null for anonymous chats; only the owner may continue one.
/// The id is a random UUIDv4 (not a cuid) because for anonymous chats it is the only credential.
model Conversation {
  id         String    @id @default(uuid())
  customerId String?
  /// Cascade, not SetNull: a deleted customer's chats must not turn into anonymous, id-only ones.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  messages   Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

/// Only user/assistant text is stored; tool output is re-fetched each turn so it is never stale.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(CONFIRMED)
  totalCents Int
  currency   String      @default("USD") @db.Char(3)
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  quote      OrderQuote?

  @@index([customerId, createdAt])
}

/// A server-issued order quote from the assistant. Confirming one (by the client, with its id)
/// is the only way chat places an order; the model can create quotes but never confirm them.
/// The id is a random UUIDv4 because the client presents it back as the confirmation.
// ponytail: expired quotes are deleted only when the same customer requests a new one; add a
// periodic cleanup if inactive customers' leftovers ever matter.
model OrderQuote {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// [{ productId, quantity, unitPriceCents }], merged and sorted like an order's lines.
  lines       Json
  totalCents  Int
  currency    String    @db.Char(3)
  expiresAt   DateTime
  /// Set when a confirmation claims the quote; serialises concurrent confirms.
  confirmedAt DateTime?
  orderId     String?   @unique
  order       Order?    @relation(fields: [orderId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  /// Price snapshot at order time; later catalog price changes don't rewrite history.
  unitPriceCents Int

  @@index([orderId])
}
