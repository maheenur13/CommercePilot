  "info": {
    "title": "CommercePilot API",
    "description": "E-commerce backend with a conversational assistant. Every response uses the envelope `{ success, data, meta }` or `{ success: false, error: { code, message, details?, requestId } }`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "admin-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-key"
      }
    },
    "schemas": {
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ]
          },
          "latencyMs": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyCheckDto"
          }
        },
        "required": [
          "database"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "timestamp",
          "checks"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "example": "4f1c2b8e-1d2a-4c7e-9a51-2f0f1f7f1a10"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "PageMetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "example": "4f1c2b8e-1d2a-4c7e-9a51-2f0f1f7f1a10"
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 48
          },
          "totalPages": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "requestId",
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "items.0.quantity"
          },
          "messages": {
            "example": [
              "quantity must not be less than 1"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "requestId": {
            "type": "string",
            "example": "4f1c2b8e-1d2a-4c7e-9a51-2f0f1f7f1a10"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "MoneyDto": {
        "type": "object",
        "properties": {
          "amountCents": {
            "type": "number",
            "example": 19900
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "formatted": {
            "type": "string",
            "example": "$199.00"
          }
        },
        "required": [
          "amountCents",
          "currency",
          "formatted"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "stock": {
            "type": "number"
          },
          "inStock": {
            "type": "boolean",
            "description": "Derived convenience flag: `stock > 0`."
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "description",
          "category",
          "brand",
          "price",
          "stock",
          "inStock",
          "attributes",
          "active",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "brand": {
            "type": "string",
            "maxLength": 60
          },
          "priceCents": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "stock": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "sku",
          "name",
          "category",
          "priceCents",
          "stock"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "brand": {
            "type": "string",
            "maxLength": 60
          },
          "priceCents": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
